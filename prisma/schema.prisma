// Схема базы CoFFeeJD для Prisma.
// Таблицы уже существуют (SQLite), поэтому имена полей совпадают с колонками в базе,
// а сама структура меняется SQL-миграциями из prisma/migrations (их запускает src/database/migrations.js).
// Связей между моделями нет намеренно: товар можно удалить, а старые заказы с ним должны остаться.

generator client {
  provider = "prisma-client-js"
  output   = "../src/database/generated"
}

datasource db {
  provider = "sqlite"
}

// Товар, вариант товара (group_key + option_label), доп или набор
model Product {
  id               Int     @id @default(autoincrement())
  name             String
  description      String?
  price            Int // в копейках; для товаров на вес — копеек за 1 г (мл)
  photo_url        String?
  stock            Int     @default(0)
  category         String?
  name_en          String?
  description_en   String?
  category_en      String?
  group_key        String?
  option_label     String?
  option_label_en  String?
  option2_label    String?
  option2_label_en String?
  is_addon         Int     @default(0)
  addon_for        String?
  unit             String? // g — на вес, ml — на объём, null — штучный
  step             Int     @default(1)
  min_qty          Int     @default(1)

  @@map("products")
}

model CartItem {
  chat_id    Int
  product_id Int
  quantity   Int @default(1)

  @@id([chat_id, product_id])
  @@map("cart_items")
}

model Order {
  id               Int     @id @default(autoincrement())
  chat_id          Int
  status           String  @default("pending") // pending | awaiting_payment:<id платежа> | paid | assembling | shipped | delivered | cancelled
  total            Int
  address          String?
  payment_provider String?
  order_code       String?
  created_at       String? @default(dbgenerated("CURRENT_TIMESTAMP"))
  promo_code       String?
  discount_percent Int     @default(0)
  delivery_city    String?
  delivery_cost    Int     @default(0)
  delivery_method  String?
  contact          String?
  carrier          String?
  addr_raw         String?
  track            String?
  rating           Int?
  status_at        String?
  status_msg_id    Int?
  payment_id       String?
  paid_at          String?

  @@map("orders")
}

model OrderItem {
  id          Int @id @default(autoincrement())
  order_id    Int
  product_id  Int
  quantity    Int
  price       Int
  stock_taken Int @default(0) // сколько реально списали со склада — столько и вернём при отмене

  @@index([order_id], map: "order_items_order")
  @@map("order_items")
}

model PromoCode {
  id               Int     @id @default(autoincrement())
  code             String  @unique
  discount_percent Int
  active           Int     @default(1)
  max_uses         Int?
  used_count       Int     @default(0)
  created_at       String? @default(dbgenerated("CURRENT_TIMESTAMP"))

  @@map("promo_codes")
}

model DeliveryRate {
  id         Int     @id @default(autoincrement())
  city       String  @unique // COLLATE NOCASE в базе
  city_en    String?
  price      Int
  active     Int     @default(1)
  created_at String? @default(dbgenerated("CURRENT_TIMESTAMP"))

  @@map("delivery_rates")
}

model UserSettings {
  chat_id Int     @id
  lang    String  @default("ru")
  name    String?
  contact String?

  @@map("user_settings")
}

model BundleItem {
  bundle_id  Int
  product_id Int
  qty        Int @default(1)

  @@id([bundle_id, product_id])
  @@map("bundle_items")
}

model StockLogEntry {
  id         Int    @id @default(autoincrement())
  ts         String @default(dbgenerated("datetime('now')"))
  product_id Int
  delta      Int
  after      Int
  reason     String
  order_id   Int?

  @@index([ts], map: "idx_stock_log_ts")
  @@map("stock_log")
}

model Subscription {
  id              Int     @id @default(autoincrement())
  chat_id         Int
  items           String // JSON [{product_id, quantity}]
  interval_days   Int
  next_date       String // YYYY-MM-DD
  active          Int     @default(1)
  delivery_method String?
  delivery_city   String?
  carrier         String?
  address         String?
  contact         String?
  last_order_id   Int?
  postponed       Int     @default(0)
  created_at      String? @default(dbgenerated("CURRENT_TIMESTAMP"))

  @@index([active, next_date], map: "subscriptions_due")
  @@map("subscriptions")
}

model Setting {
  key   String @id
  value String // JSON

  @@map("settings")
}

model Message {
  id           Int     @id @default(autoincrement())
  chat_id      Int
  from_owner   Int     @default(0)
  text         String?
  photo        String? // file_id фото в Telegram
  owner_msg_id Int? // id копии сообщения у владелицы (чтобы ответить реплаем)
  is_read      Int     @default(0)
  created_at   String? @default(dbgenerated("CURRENT_TIMESTAMP"))

  @@index([chat_id, id], map: "messages_chat")
  @@map("messages")
}
